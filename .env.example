# Earful — object storage credentials. Copy to .env and fill in.
# Defaults walk through Cloudflare R2 (recommended: free tier, public URL, no
# egress fees). Any S3-compatible store works too — see the per-line notes.

# Endpoint URL.
#   R2:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (API-token result screen)
#   S3:  https://s3.<region>.amazonaws.com   B2/Spaces/Wasabi/MinIO: their endpoint
R2_ENDPOINT=

# Access Key ID.
R2_ACCESS_KEY_ID=

# Secret Access Key — for R2, shown ONCE on the token result screen. Copy it then.
R2_SECRET_ACCESS_KEY=

# Bucket name you created.
R2_BUCKET=earful

# Public base URL the bucket is served from (no trailing slash).
#   R2:  https://pub-<hash>.r2.dev   (enable the bucket's public dev URL)
#   else: your bucket's public website / CDN URL
R2_PUBLIC_URL_BASE=

# Signing region. Leave as "auto" for R2; set the bucket's real region for AWS S3.
R2_REGION=auto
