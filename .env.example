# Earful — environment variables. Copy to .env and fill in.
# All five come from the Cloudflare R2 dashboard (one-time setup).

# [Step 4] Endpoint shown on the API-token result screen.
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# [Step 4] Access Key ID from the API-token result screen.
R2_ACCESS_KEY_ID=

# [Step 4] Secret Access Key — shown ONCE on the token result screen. Copy immediately.
R2_SECRET_ACCESS_KEY=

# [Step 2] The bucket name you created.
R2_BUCKET=earful

# [Step 3] Public Development URL after enabling public access.
# Format: https://pub-<hash>.r2.dev  (no trailing slash)
R2_PUBLIC_URL_BASE=
