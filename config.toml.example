# Copy to config.toml and edit. config.toml is gitignored (it holds your
# podcast's identity); this example is the template.

[podcast]
title = "Earful"
description = "AI-produced episodes on whatever I want to learn next."
author = "Your Name"
email = "you@example.com"
language = "en-us"
explicit = false
category = "Education"
link = ""

# Each host is a character: a name, a Kokoro voice, and a persona that shapes how
# the script is written. Voice prefixes: am_/af_ = US male/female, bm_/bf_ = UK.
[hosts.host_a]
name = "Theo"
voice = "am_puck"
pan = -0.15   # stereo placement: -1 left .. +1 right
persona = "The one with skin in the game. Pragmatic, a little anxious, allergic to hype; wants what actually works and will argue or admit when he's been talked out of something. Shorter, punchier lines; reacts fast."

[hosts.host_b]
name = "Mara"
voice = "af_heart"
pan = 0.15
persona = "The one who's actually done it. Grounds things in specifics and numbers, challenges romantic assumptions and lazy fears with tough-love, reassures with evidence. Occasionally wry. Longer, structured turns when making a real point."

[tts]
model = "mlx-community/Kokoro-82M-bf16"
lang_code = "a"
sample_rate = 24000
speed = 1.1           # 1.0 = Kokoro default; >1 speaks faster
# Organic variation, randomized per turn (seeded from episode content -> reproducible).
pause_min_ms = -100   # negative = brief overlap (hosts talk over each other)
pause_max_ms = 500
speed_jitter = 0.04   # +/- fraction of speed per turn
gain_jitter_db = 2.0  # +/- dB per turn (mic-distance / turning-to-cohost feel)
drift_db = 1.5        # slow level drift WITHIN a turn
room_tone_db = -60.0  # faint pink-noise floor; <= -120 disables
mic_chain = true      # gentle highpass + compression on export
