# Copy to config.toml and edit. config.toml is gitignored (it holds your
# podcast's identity); this example is the template.

[podcast]
title = "Earful"
description = "AI-produced episodes on whatever I want to learn next."
author = "Your Name"
email = "you@example.com"
language = "en-us"
explicit = false
category = "Education"
link = ""

# Each host is a character: a name, a Kokoro voice, and a persona that shapes how
# the script is written. Voice prefixes: am_/af_ = US male/female, bm_/bf_ = UK.
[hosts.host_a]
name = "Theo"
voice = "am_puck"
pan = -0.15   # stereo placement: -1 left .. +1 right
persona = "A peer who's done the homework, not a novice — the one who drives and presses. Quick and probing: he takes positions, defends them, hunts for the underlying mechanism and the spot where an argument doesn't hold. Edge and energy; shorter, sharper lines. When he asks a question it's to pressure-test, not because he's lost."

[hosts.host_b]
name = "Mara"
voice = "af_heart"
pan = 0.15
persona = "A peer who's done the homework, not a professor — the one who complicates and grounds. Reaches for the specific case, the number, the caveat, the 'it's messier than that,' and pushes back when Theo's framing gets too tidy. Wry, a little unhurried, comfortable sitting in nuance. She's thinking alongside, never lecturing."

[tts]
model = "mlx-community/Kokoro-82M-bf16"
lang_code = "a"
sample_rate = 24000
speed = 1.0           # 1.0 = Kokoro default; >1 speaks faster (compounds with listener-side playback speed)
# Organic variation, randomized per turn (seeded from episode content -> reproducible).
pause_min_ms = -100      # negative = brief overlap (hosts talk over each other)
pause_max_ms = 500
sentence_pause_ms = 100  # gap between sentences within a turn (keeps periods breathing)
beat_pause_ms = 400      # default length of a bare inline [pause] in a script
comma_pause_level = 2    # comma pause: 1 = native Kokoro (short, ~38-125ms), 2-3 = inject phonemes to lift the floor
speed_jitter = 0.04   # +/- fraction of speed per turn
gain_jitter_db = 2.0  # +/- dB per turn (mic-distance / turning-to-cohost feel)
drift_db = 1.5        # slow level drift WITHIN a turn
room_tone_db = -60.0  # faint pink-noise floor; <= -120 disables
breath_db = -28.0     # level of a scripted [breath] inhale
plosive_db = -22.0    # simulated plosive pop level; <= -120 disables
plosive_prob = 0.4    # chance a plosive-initial sentence gets a pop
mic_chain = true      # physical-mic tone chain on export (body + presence + exciter)
deess_intensity = 0.4 # de-esser strength (0 disables)
loudness_lufs = -16.0 # broadcast loudness target (EBU R128); > -70 enables loudnorm
