# Copy to config.toml and edit. config.toml is gitignored (it holds your
# podcast's identity); this example is the template.

[podcast]
title = "Earful"
description = "AI-produced episodes on whatever I want to learn next."
author = "Your Name"
email = "you@example.com"
language = "en-us"
explicit = false
category = "Education"
link = ""

[voices]
# Kokoro voice IDs. Browse options in the mlx-audio / Kokoro docs.
# Prefixes: am_/af_ = US male/female, bm_/bf_ = UK male/female.
host_a = "am_puck"
host_b = "af_heart"

[tts]
model = "mlx-community/Kokoro-82M-bf16"
lang_code = "a"
sample_rate = 24000
speed = 1.1           # 1.0 = Kokoro default; >1 speaks faster
# Organic variation, randomized per turn (seeded from episode content -> reproducible).
pause_min_ms = -100   # negative = brief overlap (hosts talk over each other)
pause_max_ms = 500
speed_jitter = 0.04   # +/- fraction of speed per turn
gain_jitter_db = 2.0  # +/- dB per turn (mic-distance / turning-to-cohost feel)
